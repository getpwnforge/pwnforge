{# Sent from the setup wizard and from nowhere else. Untranslated on purpose:
   it only has to prove the transport works, and the operator has not chosen a
   locale at that point in the flow. #}
{% extends "layout.html.j2" %}

{% block content %}
<p style="margin:0 0 24px;">
  If you are reading this, your PwnForge instance can send email. Verification
  links and password resets will reach your users.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="margin:0 0 24px;background-color:#032201;border:1px solid #4AB341;border-radius:8px;">
  <tr>
    <td style="padding:14px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#72C56A;">
      Delivery confirmed for this address.
    </td>
  </tr>
</table>

<p style="margin:0;font-size:13px;color:#9a9aa3;">
  Worth checking before you rely on it: that this message did not land in spam,
  and that the sender address above is one your domain is allowed to send from
  (SPF, DKIM and DMARC).
</p>
{% endblock %}
