{# templates/security_alert.html.j2 #}
{% extends "layout.html.j2" %}

{% block content %}
<p style="margin:0 0 12px;">{{ greeting }}</p>
<p style="margin:0 0 24px;">{{ body }}</p>

{# Table rather than a definition list: Outlook drops dl spacing entirely. #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="margin:0 0 24px;background-color:#16161a;border:1px solid #26262c;border-radius:8px;">
  <tr>
    <td style="padding:14px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td width="110" style="padding:4px 12px 4px 0;color:#5a5a63;vertical-align:top;">{{ label_when }}</td>
          <td style="padding:4px 0;color:#d4d4d8;">{{ occurred_at }}</td>
        </tr>
        <tr>
          <td style="padding:4px 12px 4px 0;color:#5a5a63;vertical-align:top;">{{ label_ip }}</td>
          <td style="padding:4px 0;color:#d4d4d8;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;">{{ ip_address }}</td>
        </tr>
        <tr>
          <td style="padding:4px 12px 4px 0;color:#5a5a63;vertical-align:top;">{{ label_device }}</td>
          <td style="padding:4px 0;color:#d4d4d8;word-break:break-word;">{{ user_agent }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin:0 0 20px;font-size:13px;color:#9a9aa3;">{{ no_action }}</p>

{# Warning-coloured, and still with no link: an alert that asks the reader to
   click is the exact shape a phishing message takes, and training users to
   follow links in security emails works against them. The instance URL in the
   footer is there for anyone who wants to act on this. #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background-color:#2A1D00;border:1px solid #E7B643;border-radius:8px;">
  <tr>
    <td style="padding:14px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#E7B643;">
      {{ not_you }}
    </td>
  </tr>
</table>
{% endblock %}
