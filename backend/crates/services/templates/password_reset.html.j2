{# Same body as email_verification.html.j2 on purpose: the two are one shape —
   a link to click, an expiry, a way out. Kept as two files rather than a
   shared macro so a change to one flow cannot silently alter the other. #}
{% extends "layout.html.j2" %}

{% block content %}
<p style="margin:0 0 12px;">{{ greeting }}</p>
<p style="margin:0 0 24px;">{{ body }}</p>

{# Button on a table cell rather than a styled <a>: Outlook ignores padding on
   inline elements, which would collapse it to a bare line of text. #}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr>
    <td bgcolor="#EB5927" style="background-color:#EB5927;border-radius:8px;">
      <a href="{{ link }}"
         style="display:inline-block;padding:13px 26px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:bold;line-height:1;color:#1a0e06;text-decoration:none;border-radius:8px;">
        {{ cta }}
      </a>
    </td>
  </tr>
</table>

{# The raw URL matters more than it looks: corporate gateways rewrite buttons,
   and a reader who distrusts the link wants to read it before following it. #}
<p style="margin:0 0 6px;font-size:13px;color:#9a9aa3;">{{ fallback_notice }}</p>
<p style="margin:0 0 24px;padding:12px;background-color:#16161a;border:1px solid #26262c;border-radius:8px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.5;color:#9a9aa3;word-break:break-all;">
  <a href="{{ link }}" style="color:#FE8E6B;text-decoration:none;">{{ link }}</a>
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="border-top:1px solid #26262c;">
  <tr>
    <td style="padding-top:20px;font-size:13px;line-height:1.6;color:#9a9aa3;">
      <p style="margin:0 0 6px;">{{ expiry }}</p>
      <p style="margin:0;">{{ ignore_notice }}</p>
    </td>
  </tr>
</table>
{% endblock %}
