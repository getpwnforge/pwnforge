{# Tables and inline CSS on purpose: Outlook renders with the Word engine and
   several clients strip <style>. Colours are the design tokens of
   frontend/src/styles/globals.css converted to hex — no mail client supports
   oklch() or var(), so the palette has to be frozen here. Keep the two in step
   by hand; --color-ember is #EB5927, the same value as the logo SVG. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    {# The design is already dark: tell Apple Mail and iOS not to invert it. #}
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <title>{{ title }}</title>
  </head>
  <body style="margin:0;padding:0;background-color:#09090b;-webkit-text-size-adjust:100%;">
    {# The line the inbox shows next to the subject. Hidden in the message
       itself, and padded so the client does not fall back to the first
       sentence of the body instead. #}
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
      {{ preheader }}
      &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#09090b;">
      <tr>
        <td align="center" style="padding:32px 16px;">

          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                 style="width:100%;max-width:600px;">

            {# The full lockup as one PNG — mark, wordmark and tagline — at the
               `md` size of the app's own Logo component. PNG and not the SVG
               the app uses: no mail client renders SVG. It rides inside the
               message as an inline attachment (see `body_with_logo` in
               email_service.rs), so it does not depend on the instance being
               reachable from the reader's mail client.

               `alt` carries the brand name here, since nothing else on the row
               does, and the font declarations on the <img> are what several
               clients use to style that alt text while images stay blocked.
               Dimensions are set in both the attribute and the style so Outlook
               reserves the right box either way; the file is 3x for retina. #}
            <tr>
              <td style="padding:0 4px 20px;font-size:0;line-height:0;">
                <img src="cid:pwnforge-logo" width="161" height="44" alt="PwnForge"
                     style="display:block;width:161px;height:44px;border:0;outline:none;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:20px;font-weight:bold;letter-spacing:-0.01em;color:#f4f4f5;">
              </td>
            </tr>

            <tr>
              <td bgcolor="#111114"
                  style="background-color:#111114;border:1px solid #26262c;border-radius:12px;padding:32px;">

                <h1 style="margin:0 0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:21px;line-height:1.3;font-weight:bold;color:#f4f4f5;letter-spacing:-0.02em;">
                  {{ title }}
                </h1>

                <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#d4d4d8;">
                  {% block content %}{% endblock %}
                </div>

              </td>
            </tr>

            <tr>
              <td style="padding:24px 4px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#5a5a63;">
                <p style="margin:0 0 8px;">{{ footer }}</p>
                <p style="margin:0 0 8px;">
                  {{ footer_instance }}
                  <a href="{{ public_url }}" style="color:#9a9aa3;text-decoration:underline;">{{ public_url }}</a>
                </p>
                <p style="margin:0;">{{ footer_note }}</p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
