{# templates/security_alert.html.j2 #}
{% extends "layout.html.j2" %}

{% block content %}
<p>{{ greeting }}</p>
<p>{{ body }}</p>

{# Table rather than a definition list: Outlook drops dl spacing entirely. #}
<table role="presentation" cellpadding="0" cellspacing="0"
       style="margin:16px 0;font-family:Arial,sans-serif;font-size:13px;color:#a3a3a3;">
  <tr>
    <td style="padding:4px 16px 4px 0;">{{ label_when }}</td>
    <td style="padding:4px 0;">{{ occurred_at }}</td>
  </tr>
  <tr>
    <td style="padding:4px 16px 4px 0;">{{ label_ip }}</td>
    <td style="padding:4px 0;">{{ ip_address }}</td>
  </tr>
  <tr>
    <td style="padding:4px 16px 4px 0;">{{ label_device }}</td>
    <td style="padding:4px 0;">{{ user_agent }}</td>
  </tr>
</table>

{# No link on purpose: an alert that asks the reader to click is the exact
   shape a phishing message takes, and training users to follow links in
   security emails works against them. #}
<p style="font-size:13px;color:#888;">{{ not_you }}</p>
{% endblock %}
