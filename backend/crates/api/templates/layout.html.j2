{# Tables and inline CSS on purpose: Outlook renders with the Word engine and
   Gmail strips external styles. Nothing here is transposable from the frontend
   design system. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
  <body style="margin:0;padding:0;background:#0d0d0d;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0">
            <tr>
              <td style="padding-bottom:24px;color:#fff;font-family:Arial,sans-serif;font-size:20px;">
                PwnForge
              </td>
            </tr>
            <tr>
              <td style="color:#e5e5e5;font-family:Arial,sans-serif;font-size:15px;line-height:1.6;">
                {% block content %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td style="padding-top:32px;font-family:Arial,sans-serif;font-size:12px;color:#888;">
                {{ footer }}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
