# ==========================================================
# ================ SYSTEM CONFIGURATION ====================
# ==========================================================
# For development purposes only. Adjust these values as needed for your environment.
# Host user/group ID, to align permissions on volume-mounted files
# (target/, node_modules/) with your host account.
# Default (1000) is correct for most Linux/WSL2 setups.
# Check with `id -u` / `id -g` if unsure (multi-user systems, macOS, etc.)
# HOST_UID=1000
# HOST_GID=1000


# =========================================================
# ================= APP CONFIGURATION =====================
# =========================================================
# Enable or disable the disposable email check. Set to true to block disposable email addresses during registration.
BLOCK_DISPOSABLE_EMAILS=true

# Enable or disable the pwned password check. Set to true to block passwords that have been exposed in known data breaches.
# Uses the "Have I Been Pwned" API to check if a password has been compromised.
# Note: Enabling this feature may introduce additional latency during user registration and password changes, as it requires an external API call.
CHECK_PWNED_PASSWORDS=true

# Number of trusted reverse proxies in front of the backend. Controls how many hops
# of the X-Forwarded-For header are trusted when resolving a client's IP address.
# 0: backend is reached directly, X-Forwarded-For is ignored entirely.
# 1 (default): one reverse proxy in front. This is the bundled docker-compose
#    setup, whose nginx proxies /api to the backend.
# 2: the bundled docker-compose setup sitting behind another reverse proxy
#    (Nginx Proxy Manager, Cloudflare, Traefik...).
#
# Set this to 0 only if nothing sits in front of the backend. Getting it wrong
# low makes every request resolve to the proxy's own address, which collapses
# all per-IP rate limits into a single shared bucket: one caller exhausting the
# login window then locks out the whole instance. The backend logs a warning
# once per process if it sees an X-Forwarded-For while this is 0.
TRUSTED_PROXY_COUNT=1

# The public URL of the application, used in email links and other contexts where the full URL is needed.
PUBLIC_URL=https://your-domain.tld

# A random 32-byte string used for initial setup and verification. Change this to a secure random value before deploying to production.
# If not used, the application will generate a random value on first run and log it to the console. This value is used for initial setup and verification processes.
# SETUP_TOKEN=32_bytes_rand_string

# Cloudflare Turnstile, the bot check on sign-in, registration, password reset
# requests and the contact form. Both keys come from the widget you create for
# your domain in the Cloudflare dashboard, and they go together: set both to
# turn Turnstile on, leave both empty to keep it off. The backend refuses to
# start with only one of them. Only the backend reads them; the frontend gets
# the site key from it at startup, so no image rebuild is needed.
#
# Once on, verification fails closed: the backend must reach
# challenges.cloudflare.com, or every protected form is refused.
# TURNSTILE_SITE_KEY=your_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Mail server configuration for sending emails (e.g., for account verification, password resets, etc.)
EMAIL_BACKEND=smtp # Use 'smtp' or 'resend' depending on your email service provider. For development, you can use a local SMTP server or a service like MailHog or 'console' for logging emails to the console.
EMAIL_FROM=no-reply@your-domain.tld # You can specify a display name as well, e.g., "PwnForge <no-reply@your-domain.tld>"
SUPPORT_EMAIL=support@your-domain.tld # The email address to use for support requests.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password
# SMTP_TLS=starttls # starttls (port 587, default) | implicit (port 465) | none (unencrypted, local relay only)

# RESEND_API_KEY=your_resend_api_key_here

# ==========================================================
# ============= PWNFORGE VERSION CONFIGURATION =============
# ==========================================================
BACKEND_VERSION=1.0.0
FRONTEND_VERSION=1.0.0


# =========================================================
# =============== DATABASE CONFIGURATION ==================
# =========================================================
POSTGRES_USER=pwnforge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pwnforge

# For local development purposes, outside of any containerized environment
# Backend container will use the DATABASE_URL defined in the docker-compose file, which points to the database container.
DATABASE_URL=postgresql://pwnforge:changeme@127.0.0.1:5432/pwnforge

# Upper bound on the backend's connection pool. Also sets the API's concurrency
# ceiling, which is derived from it, so raising this raises how many requests
# the instance handles at once. Keep it well under the database's own
# max_connections (100 by default), which migrations, the admin CLI and any
# operator session also draw from.
DATABASE_MAX_CONNECTIONS=20

# =========================================================
# =============== REDIS CONFIGURATION =====================
# =========================================================
# Password for the Redis instance, passed to the server as --requirepass and
# folded into REDIS_URL by both compose files. Required: an unauthenticated
# Redis holds every rate-limit counter and suspension cache the backend relies
# on, and anyone who can reach it can clear them.
# Generate one with:
#   openssl rand -base64 36
REDIS_PASSWORD=changeme

# For local development purposes, outside of any containerized environment
# Backend container will use the REDIS_URL defined in the docker-compose file, which points to the redis container.
REDIS_URL=redis://:changeme@127.0.0.1:6379/0


# =========================================================
# ============ JWT AND ENCRYPTION CONFIGURATION ===========
# =========================================================
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here


# =========================================================
# =============== SERVER CONFIGURATION ====================
# =========================================================
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Sets the Secure flag on the session cookies, so browsers only ever send them
# over HTTPS. Keep this true in production, including behind a TLS-terminating
# reverse proxy: the flag is about what the browser does, not about the hop
# between the proxy and the backend.
# Set it to false only for plain-HTTP local development, where browsers would
# otherwise drop the cookies and no session could be established at all.
COOKIE_SECURE=true

# Environment setting for the backend. Change to 'production' in a production environment.
# Used to determine the logging format (JSON for production, pretty for development).
BACKEND_ENV=development

# Logging configuration for the backend. Adjust log levels as needed.
RUST_LOG=info,api=debug,sea_orm=warn,sqlx=warn


# =========================================================
# =============== FRONTEND CONFIGURATION ==================
# =========================================================
HTTP_PORT=80

# Optional: extra hostname allowed to access the Vite dev server (e.g. a Tailscale
# MagicDNS name or a custom local tunnel domain). Leave empty to only allow localhost.
VITE_DEV_ALLOWED_HOST=


# =========================================================
# ============== OBJECT STORAGE (S3) ======================
# =========================================================
#
# PwnForge stores challenge attachments and avatars in S3-compatible object
# storage. There is no filesystem mode: S3 is the only backend, and there is
# no PWNFORGE_STORAGE_BACKEND switch to set.
#
# Two ways to run it:
#
#   1. Bundled Garage (the default). Leave COMPOSE_PROFILES=garage below, copy
#      ops/garage/garage.toml.example to ops/garage/garage.toml and fill in its
#      two secrets. The `garage` and `garage-init` containers then start, the
#      buckets and the scoped application key are created for you, and the
#      defaults in this file already work.
#
#   2. Your own S3. Set COMPOSE_PROFILES= (empty) so neither container starts,
#      create the two buckets yourself, and fill in the PWNFORGE_S3_* variables
#      from one of the presets below. Nothing else changes.
#
# Garage replaced MinIO, whose Community Edition is end of life (archived
# 13/02/2026, images pulled from Docker Hub 09/2026). See
# docs/adr/0002-replacing-minio.md.
#
# Which containers Compose starts. `garage` runs the bundled object store and
# its one-shot provisioner. Clear it if you are bringing your own S3.
COMPOSE_PROFILES=garage


# --- Garage admin credentials: NOT here ------------------------------------
#
# The RPC secret and the admin token live in ops/garage/garage.toml, which is
# gitignored, mounted read-only into the two Garage containers, and never seen
# by the backend. That is the same separation the MinIO root credential had.
#
#   cp ops/garage/garage.toml.example ops/garage/garage.toml
#   openssl rand -hex 32     # once for rpc_secret, once for admin_token
#
# Nothing else about Garage belongs in this file.


# --- Application credential ------------------------------------------------
#
# What the backend actually uses. With the bundled Garage these are imported by
# ops/garage/bootstrap.py; with your own S3 they are the access key of a user
# or role scoped to the two buckets.
#
# Garage requires the access key id to start with `GK` and to be 26 characters.
#
# ROTATION IS NOT "same id, new secret". Garage refuses to change an existing
# key's secret, and refuses to reuse an access key id ever again, even after
# the key is deleted. To rotate you must change BOTH lines below to new values,
# re-run `docker compose run --rm garage-init`, recreate the backend, and only
# then delete the old key:
#
#   docker compose exec garage /garage key delete --yes <old-access-key-id>
#
# The full sequence is in the docstring of ops/garage/bootstrap.py.
PWNFORGE_S3_ACCESS_KEY_ID=GKpwnforgeapp00000000000000
PWNFORGE_S3_SECRET_ACCESS_KEY=change-me-openssl-rand-hex-32

# Both are required and must name two different buckets.
PWNFORGE_S3_BUCKET_ATTACHMENTS=pwnforge-attachments
PWNFORGE_S3_BUCKET_AVATARS=pwnforge-avatars


# --- Endpoint, region, addressing style ------------------------------------
#
# Empty endpoint means real AWS S3, where the endpoint is derived from the
# region. Anything else needs the URL spelled out.
#
# Path style addresses a bucket as `host/bucket/key`, virtual-hosted style as
# `bucket.host/key`. Garage and R2 want path style; AWS and Scaleway want
# virtual-hosted.
PWNFORGE_S3_ENDPOINT=http://garage:3900
PWNFORGE_S3_REGION=garage
PWNFORGE_S3_FORCE_PATH_STYLE=true

# Presets - copy the three lines from the block that matches your provider.
#
#   Bundled Garage (default, COMPOSE_PROFILES=garage)
#     PWNFORGE_S3_ENDPOINT=http://garage:3900
#     PWNFORGE_S3_FORCE_PATH_STYLE=true
#     PWNFORGE_S3_REGION=garage          # must match s3_region in garage.toml
#
#   MinIO, if you already run one. Note it is end of life upstream; see
#   docs/adr/0002-replacing-minio.md before standing up a new instance.
#     PWNFORGE_S3_ENDPOINT=http://minio:9000
#     PWNFORGE_S3_FORCE_PATH_STYLE=true
#     PWNFORGE_S3_REGION=us-east-1
#
#   AWS S3 - empty endpoint, and the region must be the bucket's real one
#     PWNFORGE_S3_ENDPOINT=
#     PWNFORGE_S3_FORCE_PATH_STYLE=false
#     PWNFORGE_S3_REGION=eu-west-3
#
#   Cloudflare R2 - region is the literal string `auto`
#     PWNFORGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     PWNFORGE_S3_FORCE_PATH_STYLE=true
#     PWNFORGE_S3_REGION=auto
#
#   Scaleway Object Storage
#     PWNFORGE_S3_ENDPOINT=https://s3.fr-par.scw.cloud
#     PWNFORGE_S3_FORCE_PATH_STYLE=false
#     PWNFORGE_S3_REGION=fr-par


# --- Bundled Garage tuning (profile `garage` only) -------------------------
#
# The node's weight in the partition ring. NOT a storage quota: a node
# advertising 100M will happily store far more than that, and on a single node
# the value is simply 100% of the ring, so it has no practical effect. It
# starts to matter only if you add a second node and the two shares have to be
# weighed against each other.
#
# What actually bounds storage is the filesystem. If you want a ceiling below
# that, set a per-bucket quota:
#
#   docker compose exec garage /garage bucket set-quotas pwnforge-attachments --max-size 50G
#
# The backend reports a quota refusal as HTTP 507 `storage_quota_exceeded`,
# distinct from an outage, so it is safe to set one.
PWNFORGE_GARAGE_CAPACITY=100G

# Failure domain this node belongs to. Only meaningful with several nodes.
PWNFORGE_GARAGE_ZONE=pwnforge


# --- Optional --------------------------------------------------------------
#
# Prefixes every key, so one bucket can be shared with another tenant or
# another application. Leave empty unless you need it.
PWNFORGE_S3_KEY_PREFIX=

# Public CDN origin for avatars, with no trailing slash. Avatars only -
# attachments are never served by a public URL, and the code has no way to
# build one for them.
#
# Setting this means avatars are served by the CDN with no permission check.
# That is fine for user, team and workspace pictures; do not read it as a
# general statement about uploaded files. Leave empty to serve every avatar
# through the API, which checks permissions on each request and answers
# `Cache-Control: private`.
PWNFORGE_S3_PUBLIC_BASE_URL=
